APP_NAME=CauriShop
APP_ENV=production
APP_KEY={{ vault_app_key }}
APP_DEBUG=false
APP_URL={{ vault_app_url }}

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# ── Database (DigitalOcean Managed PostgreSQL) ─────────────────
DB_CONNECTION=pgsql
DB_HOST={{ vault_db_host }}
DB_PORT={{ vault_db_port }}
DB_DATABASE={{ vault_db_database }}
DB_USERNAME={{ vault_db_username }}
DB_PASSWORD={{ vault_db_password }}
DB_SSLMODE={{ vault_db_sslmode }}

# ── Sessions / Cache / Queue ──────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN={{ vault_session_domain }}

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ──────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS={{ vault_mail_from_address }}
MAIL_FROM_NAME="${APP_NAME}"
