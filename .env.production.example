APP_NAME=CauriShop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=caurishop
DB_USERNAME=caurishop
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD


REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com


BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Stockage des fichiers — DigitalOcean Spaces
FILESYSTEM_DISK=spaces
DO_SPACES_KEY=CHANGE_ME_SPACES_KEY
DO_SPACES_SECRET=CHANGE_ME_SPACES_SECRET
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=caurishop
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_URL=https://caurishop.sfo3.digitaloceanspaces.com

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@your-domain.com
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"
